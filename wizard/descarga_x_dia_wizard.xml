<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_import_cfdi_invoice_xml_attachment_form" model="ir.ui.view">
            <field name="name">descarga.x.dia.wizard.form</field>
            <field name="model">descarga.x.dia.wizard</field>
            <field name="arch" type="xml">
                <form>
                	<group>
	                	<group>
	                		<field name="start_date" required="1" />
	                	</group>
	                	<group>
	                		<field name="end_date" required="1" />
	                	</group>
                	</group>
                	
                	<footer>
                        <button name="download_cfdi_invoices_btw_two_dates" string="Descargar" type="object" class="oe_highlight"/> 
                        <button string="Cancelar" class="oe_highlight" special="cancel" />
                    </footer>
               </form>
            </field>
        </record>

        <record id="descargar_x_dia_action" model="ir.actions.act_window">
            <field name="name">Descarga Dia</field>
            <field name="type">ir.actions.act_window</field>
            <field name='res_model'>descarga.x.dia.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_import_cfdi_invoice_xml_attachment_form"/>
            <!-- <field name="context">{'l10n_mx_edi_invoice_type': 'in'}</field> -->
            <field name="target">new</field>
        </record>
        <menuitem action="descargar_x_dia_action" id="descargar_x_dia_wizard" name="Descarga Dia" parent="main_manu_attachment_cfdi_invoices"/>

        <!-- <menuitem action="action_attachment_cfdi_supplier_invoices"
              id="menu_action_attachment_cfdi_supplier_invoices"
              parent="main_manu_attachment_cfdi_invoices"
              name="Documentos digitales"
              sequence="10"/> -->
    </data>
</odoo>